{
  "name": "dotpath",
  "version": "0.1.0",
  "private": true,
  "description": "Secret-safe public dotfiles starter for agentic dev workflows.",
  "type": "module",
  "bin": {
    "dotpath": "./bin/dotpath.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "docs",
    "scripts",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "npm run check:syntax && npm run check:secrets",
    "check:syntax": "bash -n scripts/validate.sh && find examples scripts tests/fixtures -name '*.sh' -print0 | xargs -0 -n1 bash -n",
    "check:secrets": "node bin/dotpath.js scan --path .",
    "validate": "bash scripts/validate.sh",
    "smoke": "bash scripts/smoke.sh",
    "package:smoke": "node scripts/package-smoke.mjs",
    "release:check": "npm test && npm run check && npm run smoke && npm run package:smoke && npm run validate"
  },
  "keywords": [
    "dotfiles",
    "zsh",
    "git-aliases",
    "agentic-workflow",
    "bootstrap",
    "secret-scanner"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/dotpath.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/dotpath/issues"
  },
  "homepage": "https://github.com/rogerchappel/dotpath#readme"
}
