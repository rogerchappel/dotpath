{
  "name": "dotpath",
  "version": "0.1.0",
  "description": "Secret-safe public dotfiles starter for agentic dev workflows.",
  "type": "module",
  "bin": {
    "dotpath": "./bin/dotpath.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": ["bin", "src", "examples", "docs", "scripts", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check:syntax": "bash -n scripts/validate.sh && find examples scripts tests/fixtures -name '*.sh' -print0 | xargs -0 -n1 bash -n",
    "check:secrets": "node bin/dotpath.js scan --path .",
    "validate": "bash scripts/validate.sh"
  },
  "keywords": ["dotfiles", "zsh", "git-aliases", "agentic-workflow", "bootstrap", "secret-scanner"],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": { "node": ">=20" }
}
